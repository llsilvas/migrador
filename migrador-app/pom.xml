<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>prodesp.bio</groupId>
        <artifactId>migrador-iirgd</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>migrador-app</artifactId>
    <name>Migrador Application</name>
    <description>Spring Boot Application principal - Entry point</description>

    <dependencies>
        <!-- Internal modules -->
        <dependency>
            <groupId>prodesp.bio</groupId>
            <artifactId>migrador-batch-control</artifactId>
        </dependency>
        <dependency>
            <groupId>prodesp.bio</groupId>
            <artifactId>migrador-batch-workers</artifactId>
        </dependency>

        <!-- Spring Boot Web (para REST API) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- H2 Database para Spring Batch metadata em testes -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JDBC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>prodesp.bio.migrador.MigradorApplication</mainClass>
                    <!-- JVM flags otimizadas para Virtual Threads -->
                    <jvmArguments>
                        -Xms4g -Xmx4g
                        -XX:+UseG1GC
                        -XX:MaxGCPauseMillis=200
                        -Djdk.virtualThreadScheduler.parallelism=16
                        -Djdk.virtualThreadScheduler.maxPoolSize=32
                        -XX:MaxDirectMemorySize=1g
                        -XX:MetaspaceSize=256m
                        -XX:MaxMetaspaceSize=512m
                        -XX:+UseStringDeduplication
                        -XX:+UseCompressedOops
                        -Dfile.encoding=UTF-8
                        -Duser.timezone=America/Sao_Paulo
                    </jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
